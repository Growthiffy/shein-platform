PORT=4001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/shein
JWT_SECRET=change_me

# ---- Email (verification codes) ----
# Pick ONE provider. If neither is set, codes are NOT emailed:
#   - in development the signup/resend response returns a `devCode` so you can test
#   - in production the signup/resend endpoint returns an error (email is required)
#
# Option A (recommended for Vercel/serverless): Resend HTTP API
#   1. Create a key at https://resend.com/api-keys
#   2. Set RESEND_API_KEY below
#   3. MAIL_FROM must be a verified sender/domain (e.g. "Shein <no-reply@yourdomain.com>")
#      Until you verify a domain, Resend allows "onboarding@resend.dev".
RESEND_API_KEY=

# Option B: classic SMTP (Gmail app-password, Brevo, Mailgun, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

MAIL_FROM="Shein <onboarding@resend.dev>"

# ---- CORS ----
# Comma-separated allowed origins. localhost and *.vercel.app are ALWAYS allowed.
# Add custom production domains here, e.g. https://app.shein.com
CORS_ORIGINS=http://localhost:3010,http://localhost:3011
